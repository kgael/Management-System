# Puerto del servidor (Railway asigna uno automáticamente)
PORT=5000

# Entorno
NODE_ENV=production

# Firebase Admin SDK - Obtener del proyecto Firebase
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-id.iam.gserviceaccount.com

# URL del frontend en producción
FRONTEND_URL=https://tu-frontend.netlify.app

# Opcional: Configuraciones adicionales
LOG_LEVEL=info